# Production secrets for docker-compose.prod.yml.
#
# On the server: copy this to `.env` (same directory as docker-compose.prod.yml)
# and fill in real values. This file is gitignored — never commit the real one.
# It's read twice: by `docker compose` itself for ${VAR} substitution in
# docker-compose.prod.yml, and passed into the api container as its runtime env.

ENVIRONMENT=production

# Generate each with: openssl rand -hex 32
# Must differ from each other and be at least 32 characters — the app refuses
# to start in production otherwise (see backend/app/core/config.py).
SECRET_KEY=
ADMIN_SECRET_KEY=

# Postgres password (used by both the db and api services below).
POSTGRES_PASSWORD=

# Your real domain, https, no trailing slash — used for CORS and links in emails.
FRONTEND_ORIGIN=https://your-domain.example

# Keep false until TLS is actually live (DEPLOY.md step 5) — a Secure cookie
# sent over plain HTTP is silently dropped by browsers, which locks everyone
# out of /admin-tools and SQLAdmin even with correct credentials. Flip to
# true right after certbot issues the certificate.
SECURE_COOKIES=false

# First admin account — created automatically on first startup if no admin
# exists yet. Log in with this once, then manage further roles via SQLAdmin.
INITIAL_ADMIN_EMAIL=admin@your-domain.example
INITIAL_ADMIN_PASSWORD=

# Email — PRIMARY SMTP = your Yandex mailbox (brand-ish From; fine for
# Yandex/Mail.ru recipients). When a send fails (e.g. Yandex 554-rejects a Gmail
# recipient), it automatically falls back to the Gmail transport below.
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=DАЙ ХАРD Чебоксары <you@yandex.ru>

# FALLBACK SMTP = a dedicated Gmail account (2FA + app password; no card needed).
# Kicks in only when the primary errors, and delivers to Gmail reliably.
# Leave SMTP_FALLBACK_HOST empty to disable the fallback.
SMTP_FALLBACK_HOST=smtp.gmail.com
SMTP_FALLBACK_PORT=587
SMTP_FALLBACK_USERNAME=diehardcheb.mail@gmail.com
SMTP_FALLBACK_PASSWORD=
SMTP_FALLBACK_FROM=DАЙ ХАРD Чебоксары <diehardcheb.mail@gmail.com>

# File limits (bytes) — same as dev defaults, override if needed.
MAX_IMAGE_SIZE_BYTES=10485760
MAX_TRACK_FILE_SIZE_BYTES=5242880
RESULT_DISTANCE_TOLERANCE_PCT=10
RESULT_START_TIME_TOLERANCE_MINUTES=60

# Altcha captcha (self-hosted proof-of-work, no external service/signup). Set a
# random secret to enable — `openssl rand -hex 32`. Leave empty to disable. The
# gate is adaptive: a captcha is only demanded after repeated failed
# logins/registrations per IP (thresholds below), and always for anonymous
# support tickets.
ALTCHA_HMAC_KEY=
# Proof-of-work difficulty (higher = more CPU per solve; 50k–100k ~instant,
# 500k–2M gives a noticeable per-attempt cost against bots).
ALTCHA_MAX_NUMBER=100000
CAPTCHA_LOGIN_THRESHOLD=3
CAPTCHA_REGISTER_THRESHOLD=3
CAPTCHA_ATTEMPT_WINDOW_MINUTES=15

# Host path the api container's media directory is bind-mounted from — the
# host nginx serves /media/* directly from this same path (see nginx/dh.conf).
MEDIA_HOST_PATH=/srv/dh/media

# TESTING SWITCH — forces the newbie survey onto every runner regardless of
# prior_experience/attendance, so the whole flow can be tried without a fresh
# "never ran before" account. Leave unset/false normally; to roll back, just
# remove this line (or set to false) and restart the api container — no
# migration, no data change.
# SURVEY_FORCE_FOR_ALL=true
