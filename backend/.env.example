# App
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database
DATABASE_URL=postgresql+asyncpg://dh:dh@db:5432/dh
TEST_DATABASE_URL=sqlite+aiosqlite:///./test.db

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Media storage (local volume, mounted into container)
MEDIA_ROOT=/app/media
MEDIA_URL=/media

# File limits (bytes)
MAX_IMAGE_SIZE_BYTES=10485760
MAX_TRACK_FILE_SIZE_BYTES=5242880

# Result auto-validation tolerances
RESULT_DISTANCE_TOLERANCE_PCT=10
RESULT_START_TIME_TOLERANCE_MINUTES=60

# Altcha captcha (self-hosted proof-of-work, no external service). Leave empty
# to disable (dev default); set `openssl rand -hex 32` to enable. Adaptive gate:
# only kicks in after repeated failed logins/registrations per IP, and always
# for anonymous support tickets.
ALTCHA_HMAC_KEY=
# Proof-of-work difficulty (higher = more CPU per solve; 500k–2M for real cost).
ALTCHA_MAX_NUMBER=100000
CAPTCHA_LOGIN_THRESHOLD=3
CAPTCHA_REGISTER_THRESHOLD=3
CAPTCHA_ATTEMPT_WINDOW_MINUTES=15

# Email
# EMAIL_BACKEND=console -> prints emails to stdout instead of sending (dev default)
# EMAIL_BACKEND=smtp -> sends via the PRIMARY SMTP_* settings, then falls back to
#   SMTP_FALLBACK_* if the primary send fails (e.g. Yandex 554-rejects a Gmail
#   recipient, or the primary is down / over its limit).
#
# PRIMARY = Yandex mailbox: enable 2FA (id.yandex.ru), create an app password
# (id.yandex.ru/security/app-passwords, type "Mail"); SMTP_FROM must match that
# address. Good for Yandex/Mail.ru; free @yandex.ru delivers poorly to Gmail —
# that's what the fallback covers.
#
# FALLBACK = a dedicated Gmail account (2FA + app password via
# myaccount.google.com -> Security -> App passwords; no payment card). Delivers
# to Gmail reliably; free Gmail caps ~500 emails/day. Set the From to the
# fallback account's own address (SPF/DKIM alignment). Leave host empty to disable.
EMAIL_BACKEND=console
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=DАЙ ХАРD <you@yandex.ru>

SMTP_FALLBACK_HOST=smtp.gmail.com
SMTP_FALLBACK_PORT=587
SMTP_FALLBACK_USERNAME=
SMTP_FALLBACK_PASSWORD=
SMTP_FALLBACK_FROM=DАЙ ХАРD <you@gmail.com>

# SQLAdmin
ADMIN_SECRET_KEY=change-me-too

# Initial admin bootstrap (created on first startup if no admin exists)
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-me-admin-password
